datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  INVENTORY_MANAGER
  MARKETING_MANAGER
  SUPPORT_AGENT
  CUSTOMER
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
  EXPORT
  EXECUTE
}

model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  phoneNumber   String?
  address       String?
  role          SystemRole  @default(CUSTOMER)
  roleId        String?
  customRole    Role?       @relation(fields: [roleId], references: [id])
  auditLogs     AuditLog[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  addresses     Address[]
  cartItems     CartItem[]
  wishlist      WishlistItem[]
  orders        Order[]

  @@map("user")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("role")
}

model Permission {
  id          String           @id @default(uuid())
  resource    String
  action      PermissionAction
  description String?
  roles       RolePermission[]

  @@unique([resource, action])
  @@map("permission")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  resource   String
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("audit_log")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Address {
  id          String   @id @default(uuid())
  street      String
  city        String
  state       String?
  postalCode  String?
  country     String
  label       String   @default("home") // "home", "work", "other"
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@map("address")
}

model Product {
  id          String         @id
  slug        String         @unique
  name        String
  category    String
  price       Float
  currency    String
  color       String
  material    String
  description String
  images      String[]
  details     String[]
  fabricCare  String
  shipping    String
  sizes       String[]
  stock       Int            @default(0)
  // Promotional pricing — see CLAUDE.md / feature: promo pricing system.
  costPrice     Float?   // "Market/Cost" price — internal reference, never shown to customers
  originalPrice Float?   // "Original/List" price — struck-through comparison price
  promoPrice    Float?   // Effective sale price while a promo is active
  discountLabel String?  // Badge text, e.g. "-30%", "Liquidação"
  isPromoActive Boolean  @default(false)
  // Automatic sequential discount engine — see apps/api/src/lib/pricing.ts.
  // When on, these two fields (plus costPrice) drive pricing and the manual
  // fields above are ignored for display/checkout purposes.
  autoDiscountEnabled Boolean @default(false)
  cycleSalesCount     Int     @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  cartItems   CartItem[]
  wishlist    WishlistItem[]
  orderItems  OrderItem[]

  @@map("product")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  size      String   // E.g., "S", "M", "L"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, size])
  @@map("cart_item")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_item")
}

model Order {
  id                     String      @id @default(uuid())
  userId                 String
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressId              String
  address                Address     @relation(fields: [addressId], references: [id], onDelete: Restrict)
  status                 String      @default("PENDING") // PENDING, PAID, PROCESSING, COMPLETED, CANCELLED
  stripePaymentIntentId  String?     @unique
  subtotal               Float
  shippingCost           Float
  estimatedTax           Float
  grandTotal             Float
  carrier                String?
  trackingCode           String?
  orderItems             OrderItem[]
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@map("order")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  size      String   // Size purchased
  price     Float    // Snapshotted price at transaction time
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_item")
}
